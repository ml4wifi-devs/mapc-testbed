+static ssize_t write_file_cosr_gated_tx(struct file *file,
+	const char __user *user_buf, size_t count, loff_t *ppos)
+{
+	struct ath9k_htc_priv *priv = file->private_data;
+	struct wmi_cosr_gated_tx_cmd cmd;
+	struct wmi_cosr_gated_tx_resp resp;
+	uint8_t buff[17 + 64];
+	int rval, hdrlen, cmdlen;
+	s32 delta;
+
+	if (*ppos != 0) return 0;
+
+	/* input format (little-endian scalars), 17-byte fixed prefix:
+	 *   [8 target_tsf][1 rate][1 txpower][1 nframes][1 stamp_off]
+	 *   [1 station_id][2 seq][2 frame_len][802.11 header-template bytes]
+	 * The frame body (up to frame_len) is synthesized on-chip -- WMI_CMD_MAX_LEN
+	 * is 100 bytes so the full long frame cannot be shipped here. */
+	if (count < 17) {
+		printk("cosr_gated_tx: need at least 17 header bytes\n");
+		return -EINVAL;
+	}
+	if (count > sizeof(buff)) {
+		printk("cosr_gated_tx: too long (%d)\n", (int)count);
+		return -EMSGSIZE;
+	}
+	if (copy_from_user(buff, user_buf, count))
+		return -EFAULT;
+
+	hdrlen = count - 17;
+	memset(&cmd, 0, sizeof(cmd));
+	memcpy(cmd.target_tsf, buff, 8);        /* pass LE bytes through unchanged */
+	cmd.rate       = buff[8];
+	cmd.txpower    = buff[9];
+	cmd.nframes    = buff[10];
+	cmd.stamp_off  = buff[11];
+	cmd.station_id = buff[12];
+	cmd.seq[0]     = buff[13];
+	cmd.seq[1]     = buff[14];
+	cmd.frame_len  = cpu_to_be16(buff[15] | (buff[16] << 8)); /* firmware ntohs */
+	cmd.datalen    = cpu_to_be16(hdrlen);
+	memcpy(cmd.data, buff + 17, hdrlen);
+	memset(&resp, 0, sizeof(resp));
+
+	/* used bytes: struct offsetof(data) == 19 (after datalen) + header template */
+	cmdlen = 19 + hdrlen;
+
+	ath9k_htc_ps_wakeup(priv);
+	rval = ath9k_wmi_cmd(priv->wmi, WMI_COSR_GATED_TX_CMDID,
+			(u8 *)&cmd, cmdlen,
+			(u8 *)&resp, sizeof(resp), 2 * HZ);
+	ath9k_htc_ps_restore(priv);
+
+	if (unlikely(rval)) {
+		printk("ath9k_htc %s: WMI_COSR_GATED_TX_CMDID failed with %d\n", __FUNCTION__, rval);
+		return -EIO;
+	}
+
+	delta = (s32)(be32_to_cpu(resp.send_tsf) - be32_to_cpu(resp.target_lo));
+	printk("cosr_gated_tx: status=%d target_lo=%u send_tsf=%u delta_us=%d\n",
+		resp.status, be32_to_cpu(resp.target_lo), be32_to_cpu(resp.send_tsf), delta);
+
+	return count;
+}
+
+/* Co-SR: passive log of every beacon heard (incl. foreign APs), each with the
+ * sender's TSF (t1, from the beacon body) and our RX TSF (t2, mactime) -- the raw
+ * pairs the cross-AP offset fit needs, captured in AP mode with no monitor VIF.
+ * Read-only, off the TX/gate path. */
+#define COSR_BCN_RING 512
+struct cosr_bcn_obs { u8 mac[6]; u64 t1; u64 t2; u8 rate_idx; u16 len; s8 rssi; };
+static struct cosr_bcn_obs cosr_bcn[COSR_BCN_RING];
+static u32 cosr_bcn_head;
+static DEFINE_SPINLOCK(cosr_bcn_lock);
+
+void cosr_beacon_observe(const u8 *mac, u64 t1, u64 t2, u8 rate_idx, u16 len,
+			 s8 rssi)
+{
+	unsigned long flags;
+	struct cosr_bcn_obs *o;
+	spin_lock_irqsave(&cosr_bcn_lock, flags);
+	o = &cosr_bcn[cosr_bcn_head & (COSR_BCN_RING - 1)];
+	memcpy(o->mac, mac, 6);
+	o->t1 = t1;
+	o->t2 = t2;
+	o->rate_idx = rate_idx;
+	o->len = len;
+	o->rssi = rssi;
+	cosr_bcn_head++;
+	spin_unlock_irqrestore(&cosr_bcn_lock, flags);
+}
+
+static ssize_t read_file_cosr_beacons(struct file *file, char __user *user_buf,
+				      size_t count, loff_t *ppos)
+{
+	unsigned int size = COSR_BCN_RING * 80, len = 0;
+	unsigned long flags;
+	u32 i, h, start, n;
+	ssize_t rv;
+	struct cosr_bcn_obs *snap;
+	char *buf = kzalloc(size, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+	/* Copy under the lock, format outside it. The same lock is taken from the receive
+	 * path for every beacon heard, and this file is polled several times a second, so
+	 * formatting hundreds of lines while holding it would block reception -- on a device
+	 * whose transmit gate depends on its USB being serviced promptly. */
+	snap = kmalloc(sizeof(*snap) * COSR_BCN_RING, GFP_KERNEL);
+	if (!snap) {
+		kfree(buf);
+		return -ENOMEM;
+	}
+	spin_lock_irqsave(&cosr_bcn_lock, flags);
+	h = cosr_bcn_head;
+	start = (h > COSR_BCN_RING) ? h - COSR_BCN_RING : 0;
+	n = 0;
+	for (i = start; i < h; i++)
+		snap[n++] = cosr_bcn[i & (COSR_BCN_RING - 1)];
+	spin_unlock_irqrestore(&cosr_bcn_lock, flags);
+
+	for (i = 0; i < n && len < size - 80; i++) {
+		struct cosr_bcn_obs *o = &snap[i];
+		len += scnprintf(buf + len, size - len, "%pM %llu %llu %u %u %d\n",
+				 o->mac, o->t1, o->t2, o->rate_idx, o->len,
+				 o->rssi);
+	}
+	kfree(snap);
+	rv = simple_read_from_buffer(user_buf, count, ppos, buf, len);
+	kfree(buf);
+	return rv;
+}
+
+static const struct file_operations fops_cosr_beacons = {
+	.read = read_file_cosr_beacons,
+	.open = simple_open,
+	.owner = THIS_MODULE,
+	.llseek = default_llseek,
+};
+
+static const struct file_operations fops_cosr_gated_tx = {
+	.write = write_file_cosr_gated_tx,
+	.open = simple_open,
+	.owner = THIS_MODULE,
+	.llseek = default_llseek,
+};
