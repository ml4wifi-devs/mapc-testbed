+static ssize_t write_file_cosr_gated_tx(struct file *file,
+	const char __user *user_buf, size_t count, loff_t *ppos)
+{
+	struct ath9k_htc_priv *priv = file->private_data;
+	struct wmi_cosr_gated_tx_cmd cmd;
+	struct wmi_cosr_gated_tx_resp resp;
+	uint8_t buff[17 + 64];
+	int rval, hdrlen, cmdlen;
+	s32 delta;
+
+	if (*ppos != 0) return 0;
+
+	/* input format (little-endian scalars), 17-byte fixed prefix:
+	 *   [8 target_tsf][1 rate][1 txpower][1 nframes][1 stamp_off]
+	 *   [1 station_id][2 seq][2 frame_len][802.11 header-template bytes]
+	 * The frame body (up to frame_len) is synthesized on-chip -- WMI_CMD_MAX_LEN
+	 * is 100 bytes so the full long frame cannot be shipped here. */
+	if (count < 17) {
+		printk("cosr_gated_tx: need at least 17 header bytes\n");
+		return -EINVAL;
+	}
+	if (count > sizeof(buff)) {
+		printk("cosr_gated_tx: too long (%d)\n", (int)count);
+		return -EMSGSIZE;
+	}
+	if (copy_from_user(buff, user_buf, count))
+		return -EFAULT;
+
+	hdrlen = count - 17;
+	memset(&cmd, 0, sizeof(cmd));
+	memcpy(cmd.target_tsf, buff, 8);        /* pass LE bytes through unchanged */
+	cmd.rate       = buff[8];
+	cmd.txpower    = buff[9];
+	cmd.nframes    = buff[10];
+	cmd.stamp_off  = buff[11];
+	cmd.station_id = buff[12];
+	cmd.seq[0]     = buff[13];
+	cmd.seq[1]     = buff[14];
+	cmd.frame_len  = cpu_to_be16(buff[15] | (buff[16] << 8)); /* firmware ntohs */
+	cmd.datalen    = cpu_to_be16(hdrlen);
+	memcpy(cmd.data, buff + 17, hdrlen);
+	memset(&resp, 0, sizeof(resp));
+
+	/* used bytes: struct offsetof(data) == 19 (after datalen) + header template */
+	cmdlen = 19 + hdrlen;
+
+	ath9k_htc_ps_wakeup(priv);
+	rval = ath9k_wmi_cmd(priv->wmi, WMI_COSR_GATED_TX_CMDID,
+			(u8 *)&cmd, cmdlen,
+			(u8 *)&resp, sizeof(resp), 2 * HZ);
+	ath9k_htc_ps_restore(priv);
+
+	if (unlikely(rval)) {
+		printk("ath9k_htc %s: WMI_COSR_GATED_TX_CMDID failed with %d\n", __FUNCTION__, rval);
+		return -EIO;
+	}
+
+	delta = (s32)(be32_to_cpu(resp.send_tsf) - be32_to_cpu(resp.target_lo));
+	printk("cosr_gated_tx: status=%d target_lo=%u send_tsf=%u delta_us=%d\n",
+		resp.status, be32_to_cpu(resp.target_lo), be32_to_cpu(resp.send_tsf), delta);
+
+	return count;
+}
+
+static const struct file_operations fops_cosr_gated_tx = {
+	.write = write_file_cosr_gated_tx,
+	.open = simple_open,
+	.owner = THIS_MODULE,
+	.llseek = default_llseek,
+};
