 };
 
+/* Firmware-gated TX (us-precision Co-SR). target_tsf is 8 raw little-endian
+ * bytes (assembled by hand on the firmware side, no endian assumption). */
+struct wmi_cosr_gated_tx_cmd {
+	u8 target_tsf[8];
+	u8 rate;         /* HAL rateCode; 0 => firmware default. HT/MCS = 0x80|mcs */
+	u8 txpower;      /* 0..63; 0 => default (63) */
+	u8 nframes;      /* A-MPDU subframes; 0/1 => single */
+	u8 stamp_off;    /* offset of the 6-byte id stamp in each subframe */
+	u8 station_id;   /* stamped */
+	u8 seq[2];       /* base seq, little-endian, stamped */
+	__be16 frame_len;/* synthesized subframe length */
+	__be16 datalen;  /* 802.11 header-template length */
+	u8 data[64];
+} __packed;
+
+struct wmi_cosr_gated_tx_resp {
+	u8 status;
+	__be32 target_lo;
+	__be32 send_tsf;
+} __packed;
+
 struct wmi {
 	struct ath9k_htc_priv *drv_priv;
 	struct htc_target *htc;
