diff --git a/target_firmware/wlan/attacks.c b/target_firmware/wlan/attacks.c
index 26581c1..961c5bf 100644
--- a/target_firmware/wlan/attacks.c
+++ b/target_firmware/wlan/attacks.c
@@ -244,6 +244,137 @@ fail:
 }
 
 
+/* Find the rate-table index whose HAL rateCode == rc (so ath_buf_set_rate, which the
+ * A-MPDU head needs for correct HT PktDuration, resolves our chosen MCS). -1 if absent. */
+static a_int32_t cosr_rix_for_ratecode(const HAL_RATE_TABLE *rt, a_uint8_t rc)
+{
+	a_int32_t i;
+	for (i = 0; i < rt->rateCount; i++)
+		if (rt->info[i].rateCode == rc)
+			return i;
+	return -1;
+}
+
+/*
+ * Co-SR gated-TX subframe builder. The WMI command cannot carry a long frame
+ * (WMI_CMD_MAX_LEN is 100 B), so synthesize the body on-chip: copy the small
+ * 802.11 header template, pad to frame_len with 0x88, and write a 6-byte id stamp
+ * {C0 5A, station_id, seq_lo, seq_hi, subframe_idx} at stamp_off so a monitor can
+ * count subframes by unique id. Rate/txpower come from the caller (rate==0 => min
+ * rate default; txpower==0 => 63 max). NOACK + a single try: a gated Co-SR frame
+ * must NEVER be retransmitted -- a retry would fire ungated, outside the shared TSF.
+ */
+struct ath_tx_buf * cosr_build_frame(
+	struct ath_softc_tgt *sc, a_uint8_t *tmpl, a_int32_t tmpllen,
+	a_int32_t frame_len, a_uint8_t rate, a_uint8_t txpower,
+	a_uint8_t stamp_off, a_uint8_t station_id, a_uint8_t *seq, a_uint8_t idx)
+{
+	struct ieee80211_node_target *ni;
+	struct ath_hal *ah = sc->sc_ah;
+	a_uint8_t txrate;
+	a_int32_t i, hdrlen, pktlen;
+	struct ath_tx_buf *bf;
+	adf_nbuf_t skb;
+	struct ath_rc_series rcs[4];
+	HAL_11N_RATE_SERIES series[4];
+	unsigned char *buff;
+	const HAL_RATE_TABLE *rt;
+
+	adf_os_mem_set(rcs, 0, sizeof(struct ath_rc_series)*4);
+	adf_os_mem_set(series, 0, sizeof(HAL_11N_RATE_SERIES)*4);
+
+	adf_os_assert(sc->sc_currates != NULL);
+	rt = sc->sc_currates;
+	if (rate) {
+		/* The index and the rate code must describe the same rate: the index is what
+		 * ath_buf_set_rate uses to compute the aggregate's duration, and the code is
+		 * what goes into the descriptor. Falling back to the minimum rate for one and
+		 * keeping the unknown code for the other builds a frame whose signalled
+		 * duration does not match how it is sent. Refuse instead. */
+		a_int32_t rix = cosr_rix_for_ratecode(rt, rate);
+		if (rix < 0)
+			return NULL;
+		rcs[0].rix = rix;
+	} else {
+		rcs[0].rix = ath_get_minrateidx(sc, &sc->sc_vap[0]);
+	}
+	rcs[0].tries = 1;                 /* single try: never retransmit a gated frame */
+	rcs[0].flags = 0;
+	txrate = rate ? rate : rt->info[rcs[0].rix].rateCode;
+	if (txpower == 0) txpower = 63;
+
+	for (i = 0; i < 4; i++) {
+		series[i].Tries = (i == 0) ? 1 : 0;   /* one try, series 0 only */
+		series[i].Rate = txrate;
+		series[i].ChSel = sc->sc_ic.ic_tx_chainmask;
+		series[i].RateFlags = 0;
+	}
+
+	if (frame_len < tmpllen)
+		frame_len = tmpllen;
+
+	skb = BUF_Pool_alloc_buf_align(sc->pool_handle, POOL_ID_ATTACKS, frame_len, 0);
+	if (skb == NULL) {
+		printk("cosr: nbuf alloc failed\n");
+		return NULL;
+	}
+	buff = adf_nbuf_put_tail(skb, frame_len);
+
+	/* header template, then 0x88 filler body */
+	adf_os_mem_copy(buff, tmpl, tmpllen);
+	if (frame_len > tmpllen)
+		adf_os_mem_set(buff + tmpllen, 0x88, frame_len - tmpllen);
+
+	/* 6-byte id stamp for RX-side subframe counting */
+	if ((a_int32_t)stamp_off + 6 <= frame_len) {
+		buff[stamp_off + 0] = 0xC0;
+		buff[stamp_off + 1] = 0x5A;
+		buff[stamp_off + 2] = station_id;
+		buff[stamp_off + 3] = seq[0];
+		buff[stamp_off + 4] = seq[1];
+		buff[stamp_off + 5] = idx;
+	}
+
+	hdrlen = ieee80211_anyhdrsize(buff);
+	pktlen = frame_len - (hdrlen & 3);
+	pktlen += IEEE80211_CRC_LEN;
+
+	ni = &sc->sc_sta[0].ni;
+	if (!sc->sc_sta[0].an_valid || ni->ni_vap == NULL) {
+		BUF_Pool_free_buf(sc->pool_handle, POOL_ID_ATTACKS, skb);
+		return NULL;
+	}
+
+	bf = asf_tailq_first(&sc->sc_txbuf);
+	if (!bf) {
+		printk("cosr: no txbuf\n");
+		BUF_Pool_free_buf(sc->pool_handle, POOL_ID_ATTACKS, skb);
+		return NULL;
+	}
+	asf_tailq_remove(&sc->sc_txbuf, bf, bf_list);
+
+	bf->bf_cookie = 0;
+	bf->bf_endpt = 5;
+	bf->bf_protmode = 0;
+	/* NOACK so the hardware sends once and never waits for an ACK -> no retransmit */
+	bf->bf_flags = HAL_TXDESC_INTREQ | HAL_TXDESC_CLRDMASK | HAL_TXDESC_NOACK;
+	bf->bf_skb = skb;
+	bf->bf_node = ni;
+	bf->bf_pktlen = pktlen;           /* aggregation math (ndelim/al) reads bf_pktlen */
+	adf_os_mem_copy(bf->bf_rcs, rcs, sizeof(rcs));
+	adf_nbuf_map(sc->sc_dev, bf->bf_dmamap, skb, ADF_OS_DMA_TO_DEVICE);
+	adf_nbuf_queue_add(&bf->bf_skbhead, skb);
+
+	ah->ah_setupTxDesc(bf->bf_desc, pktlen, hdrlen, HAL_PKT_TYPE_NORMAL,
+			   txpower, txrate, 0 /* hw retries */, HAL_TXKEYIX_INVALID,
+			   bf->bf_flags, 0, 0);
+	ath_filltxdesc(sc, bf);
+	ah->ah_set11nRateScenario(bf->bf_desc, 0, 0, series, 4, 0);
+
+	return bf;
+}
+
+
 static void attack_skb_free(struct ath_softc_tgt *sc,
 			     adf_nbuf_queue_t *head,
 			     HTC_ENDPOINT_ID endpt)
