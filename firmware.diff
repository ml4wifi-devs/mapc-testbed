+/* defined in attacks.c (attacks.h is not included here) */
+extern struct ath_tx_buf * cosr_build_frame(struct ath_softc_tgt *sc, a_uint8_t *tmpl,
+			a_int32_t tmpllen, a_int32_t frame_len, a_uint8_t rate,
+			a_uint8_t txpower, a_uint8_t stamp_off, a_uint8_t station_id,
+			a_uint8_t *seq, a_uint8_t idx);
+extern void attack_free_packet(struct ath_softc_tgt *sc, struct ath_tx_buf *bf);
+
+/* Free every subframe of a hand-built Co-SR aggregate (the completion ISR calls this
+ * once on the head; the subframes hang off bf_next and are not in the txq). */
+void cosr_free_ampdu(struct ath_softc_tgt *sc, struct ath_tx_buf *head)
+{
+	struct ath_tx_buf *bf = head, *next;
+	while (bf != NULL) {
+		next = bf->bf_next;
+		bf->bf_next = NULL;
+		attack_free_packet(sc, bf);
+		bf = next;
+	}
+}
+
+/*
+ * Co-SR gated A-MPDU builder. Build `nframes` subframes and lay them out as ONE HT
+ * PPDU by hand -- the same descriptor mechanics as ath_tgt_tx_form_aggr (delimiter
+ * padding, ds_link chaining, set11nAggrFirst/Middle/Last) but WITHOUT the TID/BAW/
+ * seqno/comp machinery, so there is no Block-Ack window and NO retransmission (each
+ * subframe stays NOACK + single try). Returns the head bf whose bf_lastds spans the
+ * whole aggregate; fire it with the same ath_tgt_txqaddbuf used for a single frame.
+ * A passive monitor deaggregates the PPDU, so each subframe's (station_id,seq,idx)
+ * stamp is still countable RX-side -- no negotiated aggregation needed.
+ */
+struct ath_tx_buf * cosr_build_ampdu(struct ath_softc_tgt *sc, a_uint8_t *tmpl,
+			a_int32_t tmpllen, a_int32_t frame_len, a_uint8_t rate,
+			a_uint8_t txpower, a_uint8_t stamp_off, a_uint8_t station_id,
+			a_uint8_t *seq, a_uint8_t nframes)
+{
+	struct ath_hal *ah = sc->sc_ah;
+	struct ath_tx_buf *head = NULL, *prev = NULL, *bf;
+	struct ath_tx_desc *ds;
+	u_int16_t al = 0, bpad = 0, al_delta;
+	a_int32_t k, i;
+
+	if (nframes < 1)
+		nframes = 1;
+
+	for (k = 0; k < nframes; k++) {
+		bf = cosr_build_frame(sc, tmpl, tmpllen, frame_len, rate, txpower,
+				      stamp_off, station_id, seq, (a_uint8_t)k);
+		if (bf == NULL) {
+			if (head)
+				cosr_free_ampdu(sc, head);
+			return NULL;
+		}
+		bf->bf_next = NULL;
+
+		/* aggregate-length + delimiter accounting (mirror ath_tgt_tx_form_aggr) */
+		al_delta = ATH_AGGR_DELIM_SZ + bf->bf_pktlen;
+		al += bpad + al_delta;
+		bf->bf_ndelim = ATH_AGGR_GET_NDELIM(bf->bf_pktlen);
+		bpad = PADBYTES(al_delta) + (bf->bf_ndelim << 2);
+
+		if (prev) {
+			prev->bf_next = bf;
+			prev->bf_lastds->ds_link = ATH_BUF_GET_DESC_PHY_ADDR(bf);
+		} else {
+			head = bf;
+		}
+		for (ds = bf->bf_desc; ds <= bf->bf_lastds; ds++)
+			ah->ah_set11nAggrMiddle(ds, bf->bf_ndelim);
+		prev = bf;
+	}
+
+	/* finalize the tail */
+	prev->bf_next = NULL;
+	prev->bf_lastds->ds_link = 0;
+	prev->bf_ndelim = 0;
+	for (i = 0; i < prev->bf_dmamap_info.nsegs; i++)
+		ah->ah_set11nAggrLast(&prev->bf_descarr[i]);
+
+	/* finalize the head: HT rate (reads bf_al since isaggr) + AggrFirst, span to tail */
+	head->bf_isaggr = 1;
+	head->bf_al = al;
+	head->bf_nframes = nframes;
+	ath_buf_set_rate(sc, head);
+	ah->ah_set11nAggrFirst(head->bf_desc, head->bf_al, head->bf_ndelim);
+	head->bf_lastds = prev->bf_lastds;
+
+	return head;
+}
