diff --git a/target_firmware/wlan/if_ath.c b/target_firmware/wlan/if_ath.c
index 732cb33..f825170 100755
--- a/target_firmware/wlan/if_ath.c
+++ b/target_firmware/wlan/if_ath.c
@@ -59,6 +59,8 @@
 
 #include "attacks.h"
 #include "modwifi.h"
+#include "ar5416reg.h"
+#include "ar5416desc.h"
 
 static a_int32_t ath_numrxbufs = -1;
 static a_int32_t ath_numrxdescs = -1;
@@ -1913,6 +1915,208 @@ static void ath_constantjam(void *Context, A_UINT16 Command,
 	wmi_cmd_rsp(sc->tgt_wmi_handle, Command, SeqNo, &cmd_resp, sizeof(cmd_resp));
 }
 
+/*
+ * WMI_COSR_GATED_TX_CMDID handler.
+ * Firmware-gated TX for us-precision Co-SR: build the frame, busy-poll the on-chip
+ * TSF, then hand the frame to the AP's real data-TX path (ath_tgt_txqaddbuf) at the
+ * exact target TSF. This moves the RF release gate on-chip (us precision) instead of
+ * over the jittery USB/host path. Emission timing is measured on a monitor (radiotap
+ * tsft); no on-chip TX-done readback is attempted (the completion ISR frees the buf).
+ *
+ * When target_tsf == 0 the frame is sent immediately (ungated) -- used to validate the
+ * TX path in AP mode independently of the gate.
+ */
+#define COSR_LEAD_MAX_US   600000   /* reject targets more than 600 ms ahead */
+#define COSR_FINE_US       2000     /* final approach spun with IRQ off; coarse wait keeps IRQ on */
+/* Deadline for the drain wait below, which polls the queue rather than the clock and so has no
+ * bound of its own. Above the longest aggregate the pool allows (~1.9 ms at MCS 0), far below the
+ * 2 s the driver waits for a reply. */
+#define COSR_DRAIN_MAX_US   50000
+
+extern void ath_tgt_txqaddbuf(struct ath_softc_tgt *sc, struct ath_txq *txq,
+			      struct ath_tx_buf *bf, struct ath_tx_desc *lastds);
+
+/* Spin until the on-chip clock reaches `deadline`. 0 on arrival, -1 if the clock stopped
+ * moved backwards.
+ *
+ * A running clock ends this by itself. A MAC reset or a restart of the BSS does not: it moves the
+ * clock back, leaving the deadline hours away, and nothing is answered while this spins. */
+static int cosr_wait_tsf(struct ath_hal *ah, a_uint64_t deadline)
+{
+	a_uint64_t now, prev;
+
+	prev = ah->ah_getTsf64(ah);
+	while ((now = ah->ah_getTsf64(ah)) < deadline) {
+		if (now < prev)
+			return -1;              /* the clock was reset under us */
+		prev = now;
+	}
+	return 0;
+}
+
+static void ath_cosr_gated_tx(void *Context, A_UINT16 Command,
+			      A_UINT16 SeqNo, A_UINT8 *buffer, a_int32_t Length)
+{
+	struct ath_softc_tgt *sc = (struct ath_softc_tgt *)Context;
+	struct ath_hal *ah = sc->sc_ah;
+	WMI_COSR_GATED_TX_CMD *cmd = (WMI_COSR_GATED_TX_CMD *)buffer;
+	WMI_COSR_GATED_TX_RESP resp;
+	struct ath_tx_buf *bf = NULL;
+	a_uint64_t target, now, drain_deadline;
+	a_uint16_t datalen, frame_len;
+	a_uint32_t lo, hi;
+	a_uint32_t saved_diag, saved_ifs[HAL_NUM_TX_QUEUES];
+	int q;
+	union { a_uint64_t u64; a_uint32_t u32[2]; } t;
+	/* Fire on the VO (voice) QCU, not BE: highest DCU priority (wins medium
+	 * arbitration against the beacon/other queues) and idle in practice, so our
+	 * gated frame is the sole descriptor at the target instant. */
+	struct ath_txq *txq = sc->sc_ac2q[WME_AC_VO];
+
+	/* assemble the little-endian target bytes into two u32 halves using only
+	 * constant shifts (a variable 64-bit shift would need libgcc __ashldi3,
+	 * which is not linked into the firmware). Combine via a union: on this
+	 * big-endian target the high word is at index 0. */
+	lo = (a_uint32_t)cmd->target_tsf[0]        | ((a_uint32_t)cmd->target_tsf[1] << 8)
+	   | ((a_uint32_t)cmd->target_tsf[2] << 16) | ((a_uint32_t)cmd->target_tsf[3] << 24);
+	hi = (a_uint32_t)cmd->target_tsf[4]        | ((a_uint32_t)cmd->target_tsf[5] << 8)
+	   | ((a_uint32_t)cmd->target_tsf[6] << 16) | ((a_uint32_t)cmd->target_tsf[7] << 24);
+	t.u32[0] = hi;
+	t.u32[1] = lo;
+	target = t.u64;
+	datalen = adf_os_ntohs(cmd->datalen);
+	frame_len = adf_os_ntohs(cmd->frame_len);
+
+	resp.status = COSR_GTX_FIRED;
+	resp.target_lo = lo;
+	resp.send_tsf = 0;
+
+	if (target != 0) {
+		now = ah->ah_getTsf64(ah);
+		if (now >= target) {
+			resp.status = COSR_GTX_LATE;
+			goto out;
+		}
+		if (target - now > COSR_LEAD_MAX_US) {
+			resp.status = COSR_GTX_TOOFAR;
+			goto out;
+		}
+	}
+
+	/* nframes>1 => one true HT A-MPDU (single PPDU, N delimited subframes);
+	 * else a single frame. Both synthesize the body on-chip and stamp
+	 * (station_id, seq, subframe_idx). Reclaim on TX completion back to
+	 * POOL_ID_ATTACKS (the generic ath_buf_comp would use the wrong pool and
+	 * bleed it dry): a single frame via attack_free_packet, an aggregate via
+	 * cosr_free_ampdu (walks the subframe chain). */
+	if (cmd->nframes > 1) {
+		bf = cosr_build_ampdu(sc, cmd->data, datalen, frame_len, cmd->rate,
+				      cmd->txpower, cmd->stamp_off, cmd->station_id,
+				      cmd->seq, cmd->nframes);
+		if (bf == NULL) {
+			resp.status = COSR_GTX_NOBF;
+			goto out;
+		}
+		bf->bf_comp = cosr_free_ampdu;
+	} else {
+		bf = cosr_build_frame(sc, cmd->data, datalen, frame_len, cmd->rate,
+				      cmd->txpower, cmd->stamp_off, cmd->station_id,
+				      cmd->seq, 0 /* subframe idx */);
+		if (bf == NULL) {
+			resp.status = COSR_GTX_NOBF;
+			goto out;
+		}
+		bf->bf_comp = attack_free_packet;
+	}
+
+	/* Clear the target QCU up front so our frame will be the only descriptor.
+	 * Done here (not in the final approach) because ah_stopTxDma can block for up
+	 * to a frame airtime waiting for the QCU to go idle; keeping it out of the
+	 * 2 ms fine window avoids overrunning the target (~500 us late outliers). On
+	 * an idle/dedicated VO queue this is ~free; under load it drops queued VO. */
+	ah->ah_stopTxDma(ah, txq->axq_qnum);
+	ath_tx_draintxq(sc, txq);
+
+	/* Draining can block for up to a frame's airtime, so the instant checked at entry may
+	 * already have passed by now. Without re-reading, cosr_wait_tsf returns immediately, the
+	 * frame goes out late, and the status still says it made its instant -- which is the one
+	 * thing every timing figure downstream relies on. */
+	if (target != 0 && ah->ah_getTsf64(ah) >= target) {
+		resp.status = COSR_GTX_LATE;
+		goto drop;
+	}
+
+	/* on-chip busy-poll gate (skipped when ungated). Two phases so a large lead
+	 * (hundreds of ms) is cheap: a coarse wait with MAC interrupts ON (beacons keep
+	 * flowing and receive keeps running), then a short final approach with them OFF
+	 * so no ISR can delay the exit and fire the frame late. */
+	if (target != 0) {
+		/* coarse wait, interrupts ON, up to COSR_FINE_US before the target */
+		if (cosr_wait_tsf(ah, target - COSR_FINE_US) != 0) {
+			resp.status = COSR_GTX_CLKLOST;
+			goto drop;
+		}
+		ah->ah_setInterrupts(sc->sc_ah, 0);
+		/* Remove medium-access delay so the frame emits at the gated instant:
+		 * ignore carrier sense and zero the DCU backoff (this is also required
+		 * for Co-SR overlapping TX, where APs must fire regardless of sensing
+		 * each other). Saved and restored around the shot. */
+		saved_diag = ioread32_mac(AR_DIAG_SW);
+		iowrite32_mac(AR_DIAG_SW, saved_diag | AR_DIAG_FORCE_RX_CLEAR | AR_DIAG_IGNORE_VIRT_CS);
+		for (q = 0; q < HAL_NUM_TX_QUEUES; q++) {
+			saved_ifs[q] = ioread32_mac(AR_DLCL_IFS(q));
+			iowrite32_mac(AR_DLCL_IFS(q), 0);
+		}
+		if (cosr_wait_tsf(ah, target) != 0) {
+			iowrite32_mac(AR_DIAG_SW, saved_diag);
+			for (q = 0; q < HAL_NUM_TX_QUEUES; q++)
+				iowrite32_mac(AR_DLCL_IFS(q), saved_ifs[q]);
+			ah->ah_setInterrupts(sc->sc_ah, sc->sc_imask);
+			resp.status = COSR_GTX_CLKLOST;
+			goto drop;
+		}
+	}
+
+	/* transmit via the AP's real data-TX path (proven to emit in AP mode); the
+	 * queue was just drained, so txqaddbuf does setTxDP(ours)+startTxDma -- our
+	 * frame is the only descriptor, fired deterministically at the target. */
+	ath_tgt_txqaddbuf(sc, txq, bf, bf->bf_lastds);
+	/* The queue owns it now and its completion will return it to the pool, so the abort path
+	 * below must not also free it. */
+	bf = NULL;
+
+	if (target != 0) {
+		/* Hold the relaxed medium-access configuration until the frame has actually
+		 * left: restoring it while the PHY is still keying could defer the rest of it.
+		 * The queue reports when it has drained, which is exact. A fixed delay was not --
+		 * an aggregate at a low rate is milliseconds of airtime, so a short constant
+		 * restored the configuration mid-transmission. */
+		drain_deadline = target + COSR_DRAIN_MAX_US;
+		while (ah->ah_numTxPending(ah, txq->axq_qnum) != 0) {
+			if (ah->ah_getTsf64(ah) >= drain_deadline) {
+				/* Restoring now is exactly what the wait exists to avoid, but
+				 * holding carrier sense off indefinitely is worse. Say so, so the
+				 * shot is not counted as a clean one. */
+				resp.status = COSR_GTX_DRAIN;
+				break;
+			}
+		}
+		iowrite32_mac(AR_DIAG_SW, saved_diag);
+		for (q = 0; q < HAL_NUM_TX_QUEUES; q++)
+			iowrite32_mac(AR_DLCL_IFS(q), saved_ifs[q]);
+		ah->ah_setInterrupts(sc->sc_ah, sc->sc_imask);
+	}
+
+drop:
+	/* Built but never handed to the queue, so no completion will ever run: return it here or
+	 * the pool is exhausted after a handful of aborted shots. */
+	if (bf != NULL && bf->bf_comp != NULL)
+		bf->bf_comp(sc, bf);
+
+out:
+	wmi_cmd_rsp(sc->tgt_wmi_handle, Command, SeqNo, &resp, sizeof(resp));
+}
+
 static WMI_DISPATCH_ENTRY Magpie_Sys_DispatchEntries[] =
 {
 	{handle_echo_command,         WMI_ECHO_CMDID,               0},
@@ -1953,6 +2157,7 @@ static WMI_DISPATCH_ENTRY Magpie_Sys_DispatchEntries[] =
 	{ath_reactivejam,             WMI_REACTIVEJAM_CMDID,        0},
 	{ath_fastreply,               WMI_FASTREPLY_CMDID,          0},
 	{ath_constantjam,             WMI_CONSTANTJAM_CMDID,        0},
+	{ath_cosr_gated_tx,           WMI_COSR_GATED_TX_CMDID,      0},
 };
 
 /*****************/
