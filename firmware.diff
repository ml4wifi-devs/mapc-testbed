+/*
+ * WMI_COSR_GATED_TX_CMDID
+ * Firmware-gated TX for us-precision Co-SR: firmware busy-polls the on-chip TSF
+ * and starts TX DMA at the exact target TSF. target_tsf is a little-endian u64
+ * assembled byte-by-byte (do NOT rely on struct packing / host endianness).
+ */
+typedef PREPACK struct {
+	/** absolute 64-bit target TSF (little-endian bytes) */
+	a_uint8_t target_tsf[8];
+	/** HAL rateCode for the frame(s); 0 => firmware default (min rate). HT/MCS = 0x80|mcs */
+	a_uint8_t rate;
+	/** TX power 0..63; 0 => default (63 = max) */
+	a_uint8_t txpower;
+	/** number of A-MPDU subframes; 0 or 1 => single frame */
+	a_uint8_t nframes;
+	/** byte offset of the 6-byte id stamp within each synthesized subframe */
+	a_uint8_t stamp_off;
+	/** logical station id written into the stamp */
+	a_uint8_t station_id;
+	/** base sequence number written into the stamp (little-endian) */
+	a_uint8_t seq[2];
+	/** total length of each synthesized subframe (>= datalen); firmware pads the body */
+	a_uint16_t frame_len;
+	/** length of the 802.11 header template in data[] */
+	a_uint16_t datalen;
+	/** 802.11 header template (dst/src/bssid/frame-control); body is synthesized on-chip */
+	a_uint8_t data[64];
+} POSTPACK WMI_COSR_GATED_TX_CMD;
+
+enum COSR_GATED_TX_STATUS {
+	COSR_GTX_FIRED = 0,   /* gated and fired at target */
+	COSR_GTX_NOBF  = 1,   /* frame build failed: no tx buf, no node, or unknown rate code */
+	COSR_GTX_LATE  = 2,   /* command arrived after target: not fired */
+	COSR_GTX_TOOFAR = 3,  /* target too far ahead (> LEAD_MAX): not fired */
+	COSR_GTX_CLKLOST = 4, /* the on-chip clock was reset while the gate was waiting */
+	COSR_GTX_DRAIN = 5,   /* fired, but the queue never reported draining: the medium-access
+			       * configuration was restored while the frame may still have been
+			       * transmitting, so this shot is not trustworthy */
+};
+
+typedef PREPACK struct {
+	/** a value from COSR_GATED_TX_STATUS */
+	a_uint8_t status;
+	/** low 32 bits of the commanded target TSF (echo, us) */
+	a_uint32_t target_lo;
+	/** deprecated: never filled by the firmware, always zero */
+	a_uint32_t send_tsf;
+} POSTPACK WMI_COSR_GATED_TX_RESP;
